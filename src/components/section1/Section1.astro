<section
    id="section1"
    class="h-screen w-full text-white flex justify-center items-center"
>
    <div class="flex flex-col justify-center items-center">
        <h1 class="text-9xl lg:text-[168px] font-black leading-24">SEDSVIT</h1>
        <h4 class="text-3xl lg:text-5xl font-extralight">SPACE - IT'S PRETTY DANG COOL</h4>
    </div>
</section>

<script>
    import gsap from "gsap";
    import {
        scene,
        camera,
        initScene,
        animate,
    } from "../../scripts/threejs-scene-handler";
    import * as THREE from "three";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { loadSection1Model } from "./Section1Model.ts";

    gsap.registerPlugin(ScrollTrigger);

    initScene();
    scene.background = new THREE.Color("#000000");

    const ambientLight = new THREE.AmbientLight(0x404040);
    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.5);

    // Set initial camera position
    camera.position.set(0, 0.5, 0);
    camera.fov = 25;
    camera.updateProjectionMatrix();

    const model = await loadSection1Model();
    model.position.set(0, 0, 0);
    model.scale.set(1.0, 1.0, 1.0);

    const whiteCube = new THREE.Mesh(
        new THREE.BoxGeometry(0.2, 0.2, 0.15),
        new THREE.MeshBasicMaterial(),
    );
    whiteCube.position.set(0, 0.6, 0);
    whiteCube.scale.set(3, 1, 3);

    const pivot = new THREE.Object3D();
    pivot.position.set(0, 0, 0); // model centre
    pivot.add(camera);

    scene.add(model, pivot, whiteCube, ambientLight, directionalLight);

    gsap.to(pivot.rotation, {
        y: Math.PI * 2,
        duration: 20, // seconds per full revolution
        ease: "none", // linear, otherwise it speeds up and slows down each loop
        repeat: -1, // forever
    });

    const tl = gsap.timeline({
        scrollTrigger: {
            pin: true,
            trigger: "#section1",
            start: "top top",
            end: "bottom top",
            scrub: true,
        },
        yoyo: true,
    });

    tl.fromTo(
        camera.position,
        {
            z: 4,
            y: 0.5,
        },
        {
            z: 0,
            y: 1.5,
            duration: 1,
        },
        "k1", // k1 stands for keyframe1, its just a nice nomenclature i use to keep track of actions especially animations which take place in parallel
    )
        .to(
            camera,
            {
                fov: 80,
                duration: 1,
                onUpdate: () => camera.updateProjectionMatrix(),
            },
            "k1",
        )
        .fromTo(
            camera.rotation,
            {
                x: 0,
            },
            {
                x: -Math.PI / 2,
                duration: 1,
            },
            "k1+=0.3",
        )
        .fromTo(
            camera.position,
            {
                y: 1.5,
            },
            {
                y: 0.85,
                duration: 1,
            },
            "k2",
        );

    animate();
</script>
